# Supabase. Se copian del panel: Project Settings -> API.
# La clave anónima es PÚBLICA y viaja en el bundle: la seguridad la da RLS, no ocultarla.
# Nunca poner acá la service_role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sin estas dos variables la app arranca igual, en modo local y sin cuenta.
